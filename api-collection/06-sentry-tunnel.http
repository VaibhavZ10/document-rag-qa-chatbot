# POST /api/oversight
# Purpose: Forward frontend error-monitoring envelopes when Sentry is configured.
# Frontend caller: frontend/src/lib/sentry.ts -> frontend/src/lib/env.ts
# Authorization: None (no bearer token).
# Optional telemetry endpoint; not part of the PDF question flow. No session header.
# Body: newline-separated Sentry envelope, not one JSON object.
# This dummy DSN deliberately returns 403 and sends nothing upstream.
# Real envelopes are generated by the Sentry SDK; forwarding requires a valid Sentry DSN.

@base_url = http://127.0.0.1:8000

# Expected response (illustrative mock, not a recorded result):
# HTTP 403
# Disallowed Sentry host

### POST /api/oversight
POST {{base_url}}/api/oversight
Accept: text/plain
Content-Type: application/x-sentry-envelope

{"dsn":"https://public-key@example.invalid/123","event_id":"00000000000040008000000000000000"}
{"type":"event"}
{"event_id":"00000000000040008000000000000000","message":"Mock telemetry example","level":"info"}
